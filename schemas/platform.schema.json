{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "platform.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "vendor",
      "platformType",
      "chipIds",
      "compute",
      "targetLevel",
      "status",
      "sourceIds",
      "lastUpdated",
      "notes"
    ],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "vendor": { "type": "string", "minLength": 1 },
      "platformType": { "type": "string", "enum": ["chip_family", "compute_platform", "driving_system"] },
      "chipIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "compute": {
        "type": "object",
        "required": ["value", "unit", "precision", "sparse", "scope", "notes"],
        "additionalProperties": false,
        "properties": {
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string", "enum": ["TOPS", "TFLOPS", "unknown"] },
          "precision": { "type": "string", "enum": ["INT8", "INT4", "FP8", "FP4", "FP16", "unknown"] },
          "sparse": { "type": ["boolean", "null"] },
          "scope": { "type": "string", "enum": ["single_chip", "platform", "vehicle_total", "unknown"] },
          "notes": { "type": "string" }
        }
      },
      "targetLevel": { "type": ["string", "null"] },
      "status": { "type": "string", "enum": ["rumored", "announced", "pre_production", "mass_production", "discontinued"] },
      "sourceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
      "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "notes": { "type": "string" }
    }
  }
}
