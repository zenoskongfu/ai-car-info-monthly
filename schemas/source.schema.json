{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "publisher",
      "url",
      "publishedAt",
      "accessedAt",
      "sourceType",
      "reliability",
      "relatedEntityIds",
      "notes"
    ],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "title": { "type": "string", "minLength": 1 },
      "publisher": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "format": "uri" },
      "publishedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "accessedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "sourceType": {
        "type": "string",
        "enum": ["official", "regulatory", "financial_report", "media", "interview", "social_media", "rumor"]
      },
      "reliability": { "type": "string", "enum": ["high", "medium", "low"] },
      "relatedEntityIds": {
        "type": "array",
        "items": { "type": "string" },
        "uniqueItems": true
      },
      "notes": { "type": "string" }
    }
  }
}
